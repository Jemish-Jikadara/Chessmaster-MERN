<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ChessMaster | Login</title>

        <link rel="stylesheet" href="/css/style.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;600&family=Fraunces:wght@600;700&display=swap"
            rel="stylesheet">

        <style>
        :root {
            /* Golden Theme System */
            --cm-gold: #C9A227;
            --cm-gold-lt: #F0D265;
            --cm-gold-dk: #8F6B18;
            --cm-bg: #080810;
            --cm-bg-2: #13131d;
            --cm-line: rgba(201, 162, 39, 0.2);
            --cm-ink: #f3f4f6;
            --cm-ink-dim: #9ca3af;
            --cm-ink-faint: #6b7280;

            --bg-gold-glow: radial-gradient(circle at 50% 30%, rgba(201, 162, 39, 0.12) 0%, rgba(8, 8, 16, 1) 75%);
        }

        * { 
            margin: 0; 
            padding: 0; 
            box-sizing: border-box; 
        }

        body { 
            font-family: 'Inter', sans-serif; 
            background-color: var(--cm-bg); 
            background-image: var(--bg-gold-glow);
            background-attachment: fixed;
            color: var(--cm-ink); 
            min-height: 100vh; 
            display: flex;
            flex-direction: column;
        }

        /* ==========================
                AUTH LAYOUT
        ========================== */
        .auth-wrap { 
            flex: 1;
            display: flex; 
            align-items: center; 
            justify-content: center; 
            padding: 60px 24px; 
            position: relative; 
            overflow: hidden; 
        }

        /* Atmospheric Glows */
        .auth-wrap::before { 
            content: ''; 
            position: absolute; 
            width: 550px; 
            height: 550px; 
            background: radial-gradient(circle, rgba(201, 162, 39, 0.15) 0%, transparent 70%); 
            top: -120px; 
            left: -120px; 
            pointer-events: none; 
        }

        .auth-wrap::after { 
            content: ''; 
            position: absolute; 
            width: 450px; 
            height: 450px; 
            background: radial-gradient(circle, rgba(143, 107, 24, 0.12) 0%, transparent 70%); 
            bottom: -80px; 
            right: 5%; 
            pointer-events: none; 
        }

        /* ==========================
                AUTH CARD
        ========================== */
        .auth-card { 
            background: var(--cm-bg-2); 
            border: 1px solid var(--cm-line); 
            border-radius: 20px; 
            padding: 40px 36px; 
            width: 100%; 
            max-width: 420px; 
            position: relative; 
            z-index: 1; 
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
        }

        .auth-kicker { 
            font-family: 'JetBrains Mono', monospace; 
            font-size: 11px; 
            letter-spacing: 0.18em; 
            text-transform: uppercase; 
            color: var(--cm-gold-lt); 
            margin-bottom: 8px; 
            display: block; 
        }

        .auth-title { 
            font-family: 'Fraunces', serif; 
            font-size: 2.2rem; 
            font-weight: 700; 
            color: #ffffff; 
            margin: 0 0 8px; 
        }

        .auth-sub { 
            font-size: 14px; 
            color: var(--cm-ink-dim); 
            margin: 0 0 28px; 
            line-height: 1.6; 
        }

        /* ==========================
                ALERTS
        ========================== */
        .alert { 
            padding: 12px 16px; 
            border-radius: 10px; 
            font-size: 13px; 
            margin-bottom: 20px; 
        }

        .alert-error { 
            background: rgba(239, 68, 68, 0.1); 
            border: 1px solid rgba(239, 68, 68, 0.25); 
            color: #f87171; 
        }

        .alert-success { 
            background: rgba(74, 222, 128, 0.1); 
            border: 1px solid rgba(74, 222, 128, 0.25); 
            color: #4ade80; 
        }

        /* ==========================
                FORM & INPUTS
        ========================== */
        .auth-form { 
            display: flex; 
            flex-direction: column; 
            gap: 18px; 
        }

        .auth-form label { 
            display: flex; 
            flex-direction: column; 
            gap: 8px; 
            font-size: 11px; 
            font-family: 'JetBrains Mono', monospace; 
            letter-spacing: 0.12em; 
            color: var(--cm-ink-dim); 
            text-transform: uppercase; 
        }

        .auth-form input { 
            padding: 13px 16px; 
            background: rgba(255, 255, 255, 0.04); 
            border: 1px solid rgba(255, 255, 255, 0.12); 
            border-radius: 10px; 
            color: #ffffff; 
            font-size: 14px; 
            font-family: 'Inter', sans-serif; 
            outline: none; 
            transition: all 0.2s ease; 
        }

        .auth-form input:focus { 
            border-color: var(--cm-gold); 
            background: rgba(201, 162, 39, 0.05);
            box-shadow: 0 0 0 3px rgba(201, 162, 39, 0.15);
        }

        .auth-form input::placeholder { 
            color: var(--cm-ink-faint); 
        }

        /* ==========================
                SUBMIT BUTTON
        ========================== */
        .submit-btn { 
            padding: 14px; 
            background: linear-gradient(135deg, var(--cm-gold-dk) 0%, var(--cm-gold) 100%); 
            border: none; 
            border-radius: 10px; 
            color: #ffffff; 
            font-family: 'Syne', sans-serif; 
            font-size: 14px; 
            font-weight: 700; 
            cursor: pointer; 
            transition: transform 0.2s ease, box-shadow 0.2s ease; 
            box-shadow: 0 6px 20px rgba(201, 162, 39, 0.25); 
            margin-top: 6px; 
        }

        .submit-btn:hover { 
            transform: translateY(-2px); 
            box-shadow: 0 10px 28px rgba(201, 162, 39, 0.4); 
        }

        /* ==========================
                SWITCH FOOTER
        ========================== */
        .auth-switch { 
            text-align: center; 
            font-size: 13px; 
            color: var(--cm-ink-dim); 
            margin-top: 24px; 
        }

        .auth-switch a { 
            color: var(--cm-gold-lt); 
            text-decoration: none; 
            font-weight: 600; 
            transition: color 0.2s ease;
        }

        .auth-switch a:hover { 
            color: #ffffff; 
            text-decoration: underline;
        }
    </style>
    </head>

    <body class="cm-body">
        <%- include("../partials/navbar") %>

        <div class="auth-wrap">
            <div class="auth-card">
                <span class="auth-kicker">Player Login</span>
                <h1 class="auth-title">Welcome back</h1>
                <p class="auth-sub">Login to continue your chess journey and
                    save your match history.</p>

                <% if (error && error.length > 0) { %>
                <div class="alert alert-error"><%= error[0] %></div>
                <% } %>

                <% if (success && success.length > 0) { %>
                <div class="alert alert-success"><%= success[0] %></div>
                <% } %>

                <form action="/login" method="POST" class="auth-form">
                    <label>
                        Email
                        <input type="email" name="email"
                            placeholder="Enter email" required>
                    </label>

                    <label>
                        Password
                        <input type="password" name="password"
                            placeholder="Enter password" required>
                    </label>

                    <button type="submit" class="submit-btn">Login →</button>
                </form>

                <p class="auth-switch">
                    New to ChessMaster? <a href="/register">Create account</a>
                </p>
            </div>
        </div>

        <%- include("../partials/footer") %>
    </body>
</html>