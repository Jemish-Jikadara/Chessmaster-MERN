<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>ChessMaster | Replay</title>
        <link rel="stylesheet" href="/css/style.css">
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700;9..144,800&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
            rel="stylesheet">
        <style>
        * { margin:0; padding:0; box-sizing:border-box; }
        body { font-family:'Inter',sans-serif; background:var(--cm-bg); color:var(--cm-ink); }

        :root {
            --cm-bg: #0f0f0f;
            --cm-bg-2: #161616;
            --cm-bg-3: #1e1e1e;
            --cm-line: rgba(243,234,217,0.08);
            --cm-line-soft: rgba(243,234,217,0.04);
            --cm-ink: #f0ece4;
            --cm-ink-dim: #7a7570;
            --cm-ink-faint: #4a4642;
            --cm-brass: #c9a84c;
            --cm-brass-lt: #e8c97a;
            --cm-brass-dim: rgba(201,168,76,0.15);
            --cm-sage: #7a9569;
            --cm-sage-lt: #a4c191;
            --cm-rust: #b5541f;
        }

        .page-wrap { max-width:1100px; margin:0 auto; padding:40px 24px 80px; }

        /* -- BANNER -- */
        .replay-banner {
            background: linear-gradient(135deg, rgba(201,162,39,0.10) 0%, rgba(122,149,105,0.07) 50%, transparent 100%);
            border-bottom:1px solid var(--cm-line);
            padding:40px 24px 0;
            position:relative;
            overflow:hidden;
        }
        .replay-banner::before {
            content:''; position:absolute; width:600px; height:600px;
            background: radial-gradient(circle, rgba(201,162,39,0.12) 0%, transparent 70%);
            top:-200px; right:-100px; pointer-events:none;
        }
        .banner-inner { max-width:1100px; margin:0 auto; position:relative; z-index:1; }
        .back-link { display:inline-flex; align-items:center; gap:6px; color:var(--cm-ink-dim); font-size:13px; text-decoration:none; margin-bottom:20px; transition:color 0.2s; }
        .back-link:hover { color:var(--cm-ink); }
        .kicker { font-family:'Fraunces',serif; font-size:11px; letter-spacing:0.2em; text-transform:uppercase; color:var(--cm-brass); margin-bottom:8px; display:block; }
        .page-title { font-family:'Fraunces',serif; font-size:clamp(1.5rem,4vw,2.4rem); font-weight:700; color:var(--cm-ink); margin:0 0 6px; letter-spacing:-0.02em; }
        .page-meta { font-size:13px; color:var(--cm-ink-dim); }

        /* -- LAYOUT -- */
        .game-layout { display:grid; grid-template-columns:1fr 320px; gap:24px; margin-top:28px; }
        @media (max-width:900px) { .game-layout { grid-template-columns:1fr; } }

        /* -- BOARD SHELL -- */
        .board-shell {
            background:var(--cm-bg-2);
            border:1px solid var(--cm-line);
            border-radius:20px;
            padding:24px;
            display:flex;
            flex-direction:column;
            gap:14px;
        }
        .player-strip {
            display:flex; align-items:center; justify-content:space-between;
            padding:12px 16px;
            background:var(--cm-bg-3);
            border-radius:12px;
            border:1px solid var(--cm-line);
        }
        .ps-left { display:flex; align-items:center; gap:12px; }
        .ps-avatar {
            width:36px; height:36px; border-radius:50%;
            display:flex; align-items:center; justify-content:center;
            font-size:16px; font-weight:700;
        }
        .white-av { background:var(--cm-ink); color:var(--cm-bg); }
        .black-av { background:var(--cm-bg-3); border:1px solid var(--cm-line); color:var(--cm-ink); }
        .ps-name { font-size:14px; font-weight:600; color:var(--cm-ink); }

        .board-status {
            display:flex; align-items:center; justify-content:space-between;
            font-size:13px; padding:0 4px;
        }
        .status-label { color:var(--cm-ink-dim); font-size:12px; text-transform:uppercase; letter-spacing:0.08em; }
        .result-badge {
            padding:5px 16px; border-radius:20px;
            font-size:12px; font-family:'Fraunces',serif; font-weight:700;
        }
        .rb-white { background:rgba(201,168,76,0.12); border:1px solid rgba(201,168,76,0.25); color:var(--cm-brass-lt); }
        .rb-black { background:rgba(0,0,0,0.35); border:1px solid var(--cm-line); color:var(--cm-ink-dim); }
        .rb-draw { background:rgba(122,149,105,0.12); border:1px solid rgba(122,149,105,0.25); color:var(--cm-sage-lt); }

        /* -- BOARD (Fixed Size) -- */
        .board-wrap {
            display:flex; justify-content:center;
            padding:8px 0;
        }
        #replayBoard {
            display:grid;
            grid-template-columns:repeat(8,1fr);
            width:100%;
            max-width:480px;
            aspect-ratio:1;
            border-radius:10px;
            overflow:hidden;
            border:3px solid rgba(201,168,76,0.2);
            box-shadow:0 8px 40px rgba(0,0,0,0.4);
        }
        #replayBoard > div {
            display:flex; align-items:center; justify-content:center;
            aspect-ratio:1;
        }
        #replayBoard img {
            width:78%; height:78%;
            object-fit:contain;
            pointer-events:none;
        }

        /* -- HISTORY PANEL -- */
        .history-panel {
            background:var(--cm-bg-2);
            border:1px solid var(--cm-line);
            border-radius:20px;
            padding:24px;
            display:flex;
            flex-direction:column;
            gap:16px;
            max-height:720px;
        }
        .history-head {
            display:flex; align-items:flex-start; justify-content:space-between;
            padding-bottom:14px;
            border-bottom:1px solid var(--cm-line);
        }
        .hh-label { font-size:11px; color:var(--cm-ink-faint); text-transform:uppercase; letter-spacing:0.12em; font-family:'Fraunces',serif; }
        .history-head h2 { font-family:'Fraunces',serif; font-size:18px; font-weight:700; color:var(--cm-ink); margin:4px 0 0; }
        .move-count {
            background:rgba(201,168,76,0.12);
            border:1px solid rgba(201,168,76,0.2);
            color:var(--cm-brass-lt);
            font-family:'Fraunces',serif;
            font-size:13px; font-weight:700;
            padding:5px 12px; border-radius:20px;
        }

        /* -- CONTROLS (with Play/Pause) -- */
        .review-controls {
            display:flex; align-items:center; gap:8px;
            background:var(--cm-bg-3);
            border-radius:12px;
            padding:12px;
            border:1px solid var(--cm-line);
        }
        .review-controls button {
            background:transparent;
            border:1px solid var(--cm-line);
            border-radius:8px;
            color:var(--cm-ink-dim);
            padding:8px 12px;
            cursor:pointer;
            font-size:14px;
            transition:all 0.2s;
            display:flex; align-items:center; justify-content:center;
            min-width:36px; height:36px;
        }
        .review-controls button:hover:not(:disabled) {
            border-color:rgba(201,168,76,0.4);
            color:var(--cm-brass-lt);
            background:rgba(201,168,76,0.06);
        }
        .review-controls button:disabled {
            opacity:0.25;
            cursor:not-allowed;
        }
        .btn-play {
            background:rgba(201,168,76,0.12) !important;
            border-color:rgba(201,168,76,0.3) !important;
            color:var(--cm-brass-lt) !important;
            font-weight:600;
            min-width:64px !important;
        }
        .btn-play:hover:not(:disabled) {
            background:rgba(201,168,76,0.2) !important;
        }
        .btn-play.active {
            background:rgba(181,84,31,0.12) !important;
            border-color:rgba(181,84,31,0.3) !important;
            color:#e08a5b !important;
        }
        .review-controls span {
            flex:1; text-align:center;
            font-size:13px; color:var(--cm-ink-dim);
            font-family:'JetBrains Mono',monospace;
        }

        /* -- MOVE LIST -- */
        .move-list {
            flex:1; overflow-y:auto;
            display:flex; flex-direction:column; gap:6px;
            scrollbar-width:thin;
            scrollbar-color:var(--cm-bg-3) transparent;
        }
        .move-list p { color:var(--cm-ink-faint); font-size:13px; text-align:center; padding:20px; }
        .replay-move-item {
            background:var(--cm-bg-3);
            border:1px solid var(--cm-line);
            border-radius:10px;
            padding:10px 14px;
            font-size:13px;
            cursor:pointer;
            transition:all 0.15s;
            display:flex; align-items:center; gap:8px;
        }
        .replay-move-item:hover {
            border-color:rgba(201,168,76,0.3);
            background:rgba(201,168,76,0.05);
        }
        .replay-move-item.active {
            border-color:rgba(201,168,76,0.5);
            background:rgba(201,168,76,0.1);
        }
        .move-num { color:var(--cm-brass-lt); font-weight:700; font-family:'JetBrains Mono',monospace; min-width:28px; }
        .move-san { color:var(--cm-ink); font-weight:500; flex:1; }
        .move-sq { color:var(--cm-ink-faint); font-size:11px; font-family:'JetBrains Mono',monospace; }

        /* -- SPEED SELECTOR -- */
        .speed-label { font-size:11px; color:var(--cm-ink-faint); text-transform:uppercase; letter-spacing:0.08em; margin-bottom:6px; }
        .speed-options { display:flex; gap:6px; }
        .speed-btn {
            flex:1; padding:6px; background:var(--cm-bg-3);
            border:1px solid var(--cm-line); border-radius:8px;
            color:var(--cm-ink-dim); font-size:12px; cursor:pointer;
            transition:all 0.2s; text-align:center;
        }
        .speed-btn:hover { border-color:rgba(201,168,76,0.3); color:var(--cm-ink); }
        .speed-btn.active { background:rgba(201,168,76,0.12); border-color:rgba(201,168,76,0.3); color:var(--cm-brass-lt); font-weight:600; }

        @media (max-width:900px) {
            .game-layout { grid-template-columns:1fr; }
            #replayBoard { max-width:100%; }
            .history-panel { max-height:none; }
        }
    </style>
    </head>
    <body class="cm-body">

        <%- include("../partials/navbar") %>

        <div class="replay-banner">
            <div class="banner-inner">
                <a href="javascript:history.back()" class="back-link">← Back</a>
                <span class="kicker">Game Replay</span>
                <h1 class="page-title"><%= game.whitePlayer %> vs <%=
                    game.blackPlayer %></h1>
                <p class="page-meta"><%= game.timeControl %> &bull; <%=
                    game.timeMode %> &bull; <%= new
                    Date(game.createdAt).toLocaleDateString() %></p>
            </div>
        </div>

        <main>
            <div class="page-wrap">
                <div class="game-layout">

                    <!-- BOARD SECTION -->
                    <section class="board-shell">
                        <!-- Black Player -->
                        <div class="player-strip">
                            <div class="ps-left">
                                <div class="ps-avatar black-av">♚</div>
                                <div>
                                    <div class="ps-name"><%= game.blackPlayer
                                        %></div>
                                </div>
                            </div>
                        </div>

                        <!-- Result -->
                        <div class="board-status">
                            <span class="status-label">Result</span>
                            <% if (game.winner === "white") { %>
                            <span class="result-badge rb-white">⬜ White
                                Won</span>
                            <% } else if (game.winner === "black") { %>
                            <span class="result-badge rb-black">⬛ Black
                                Won</span>
                            <% } else { %>
                            <span class="result-badge rb-draw">Draw</span>
                            <% } %>
                        </div>

                        <!-- Board -->
                        <div class="board-wrap">
                            <div id="replayBoard"></div>
                        </div>

                        <!-- White Player -->
                        <div class="player-strip">
                            <div class="ps-left">
                                <div class="ps-avatar white-av">♔</div>
                                <div>
                                    <div class="ps-name"><%= game.whitePlayer
                                        %></div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <!-- HISTORY PANEL -->
                    <aside class="history-panel">
                        <div class="history-head">
                            <div>
                                <div class="hh-label">Match Log</div>
                                <h2>Move History</h2>
                            </div>
                            <span class="move-count"><%= game.totalMoves
                                %></span>
                        </div>

                        <!-- Controls with Play/Pause -->
                        <div class="review-controls">
                            <button id="replayFirst" title="First">⟪</button>
                            <button id="replayPrev" title="Previous">←</button>
                            <button id="replayPlay" class="btn-play"
                                title="Play/Pause">▶ Play</button>
                            <button id="replayNext" title="Next">→</button>
                            <button id="replayLast" title="Last">⟫</button>
                        </div>
                        <span id="replayStatus"
                            style="text-align:center; font-size:12px; color:var(--cm-ink-faint); font-family:'JetBrains Mono',monospace;">Move
                            0 / <%= game.totalMoves %></span>

                        <!-- Speed Selector -->
                        <div>
                            <div class="speed-label">Playback Speed</div>
                            <div class="speed-options">
                                <button class="speed-btn"
                                    data-speed="1000">1s</button>
                                <button class="speed-btn active"
                                    data-speed="2000">2s</button>
                                <button class="speed-btn"
                                    data-speed="3000">3s</button>
                            </div>
                        </div>

                        <div id="replayMoveList" class="move-list"></div>
                    </aside>

                </div>
            </div>
        </main>

        <%- include("../partials/footer") %>

        <script
            src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
        <script>
        const MOVES = <%- JSON.stringify(game.moves) %>;
        const pieceImages = {
            wp:"white-pawn", wr:"white-rook", wn:"white-knight", wb:"white-bishop",
            wq:"white-queen", wk:"white-king",
            bp:"black-pawn", br:"black-rook", bn:"black-knight", bb:"black-bishop",
            bq:"black-queen", bk:"black-king"
        };

        const chess = new Chess();
        const positionHistory = [chess.fen()];
        const verboseMoves = [];

        MOVES.forEach(san => {
            const m = chess.move(san);
            if (m) {
                verboseMoves.push(m);
                positionHistory.push(chess.fen());
            }
        });

        let currentIndex = 0;
        let isPlaying = false;
        let playInterval = null;
        let playSpeed = 2000;

        const replayBoard = document.getElementById("replayBoard");
        const replayStatus = document.getElementById("replayStatus");
        const replayMoveList = document.getElementById("replayMoveList");
        const btnFirst = document.getElementById("replayFirst");
        const btnPrev = document.getElementById("replayPrev");
        const btnPlay = document.getElementById("replayPlay");
        const btnNext = document.getElementById("replayNext");
        const btnLast = document.getElementById("replayLast");

        function getSquareName(row, col) {
            return ["a","b","c","d","e","f","g","h"][col] + (8 - row);
        }

        function renderBoard() {
            replayBoard.innerHTML = "";
            const display = new Chess();
            display.load(positionHistory[currentIndex]);
            const board = display.board();
            const lastMove = currentIndex > 0 ? verboseMoves[currentIndex - 1] : null;

            for (let row = 0; row < 8; row++) {
                for (let col = 0; col < 8; col++) {
                    const sq = getSquareName(row, col);
                    const cell = document.createElement("div");
                    const light = (row + col) % 2 === 0;
                    const isLast = lastMove && (lastMove.from === sq || lastMove.to === sq);

                    cell.style.backgroundColor = isLast
                        ? (light ? "#fef08a" : "#ca8a04")
                        : (light ? "#f0d9b5" : "#b58863");

                    const piece = board[row][col];
                    if (piece) {
                        const img = document.createElement("img");
                        img.src = `/images/pieces/${pieceImages[piece.color + piece.type]}.png`;
                        img.draggable = false;
                        cell.appendChild(img);
                    }
                    replayBoard.appendChild(cell);
                }
            }

            const total = positionHistory.length - 1;
            replayStatus.textContent = `Move ${currentIndex} / ${total}`;

            btnFirst.disabled = currentIndex <= 0;
            btnPrev.disabled = currentIndex <= 0;
            btnNext.disabled = currentIndex >= total;
            btnLast.disabled = currentIndex >= total;

            // Auto-stop at end
            if (currentIndex >= total && isPlaying) {
                stopAutoPlay();
            }

            document.querySelectorAll(".replay-move-item").forEach((el, i) => {
                el.classList.toggle("active", i === currentIndex - 1);
            });
        }

        function buildMoveList() {
            if (!verboseMoves.length) {
                replayMoveList.innerHTML = '<p>No moves.</p>';
                return;
            }
            replayMoveList.innerHTML = verboseMoves.map((m, i) => `
                <div class="replay-move-item" data-index="${i + 1}">
                    <span class="move-num">${i + 1}.</span>
                    <span class="move-san">${m.san}</span>
                    <span class="move-sq">${m.from}→${m.to}</span>
                </div>
            `).join("");

            replayMoveList.querySelectorAll(".replay-move-item").forEach(el => {
                el.addEventListener("click", () => {
                    stopAutoPlay();
                    currentIndex = Number(el.dataset.index);
                    renderBoard();
                    el.scrollIntoView({ block: "nearest" });
                });
            });
        }

        // -- AUTO PLAY FUNCTIONS --
        function startAutoPlay() {
            if (currentIndex >= positionHistory.length - 1) {
                currentIndex = 0; // Restart from beginning if at end
            }
            isPlaying = true;
            btnPlay.innerHTML = "⏸ Pause";
            btnPlay.classList.add("active");

            playInterval = setInterval(() => {
                if (currentIndex < positionHistory.length - 1) {
                    currentIndex++;
                    renderBoard();
                } else {
                    stopAutoPlay();
                }
            }, playSpeed);
        }

        function stopAutoPlay() {
            isPlaying = false;
            btnPlay.innerHTML = "▶ Play";
            btnPlay.classList.remove("active");
            if (playInterval) {
                clearInterval(playInterval);
                playInterval = null;
            }
        }

        function togglePlay() {
            if (isPlaying) {
                stopAutoPlay();
            } else {
                startAutoPlay();
            }
        }

        // -- SPEED SELECTOR --
        document.querySelectorAll(".speed-btn").forEach(btn => {
            btn.addEventListener("click", () => {
                document.querySelectorAll(".speed-btn").forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
                playSpeed = Number(btn.dataset.speed);

                // If playing, restart with new speed
                if (isPlaying) {
                    stopAutoPlay();
                    startAutoPlay();
                }
            });
        });

        // -- BUTTON EVENTS --
        btnFirst.addEventListener("click", () => { stopAutoPlay(); currentIndex = 0; renderBoard(); });
        btnPrev.addEventListener("click", () => { stopAutoPlay(); if (currentIndex > 0) { currentIndex--; renderBoard(); } });
        btnNext.addEventListener("click", () => { stopAutoPlay(); if (currentIndex < positionHistory.length - 1) { currentIndex++; renderBoard(); } });
        btnLast.addEventListener("click", () => { stopAutoPlay(); currentIndex = positionHistory.length - 1; renderBoard(); });
        btnPlay.addEventListener("click", togglePlay);

        // Keyboard shortcuts
        document.addEventListener("keydown", e => {
            if (e.key === "ArrowLeft") { stopAutoPlay(); btnPrev.click(); }
            if (e.key === "ArrowRight") { stopAutoPlay(); btnNext.click(); }
            if (e.key === "ArrowUp") { stopAutoPlay(); btnFirst.click(); }
            if (e.key === "ArrowDown") { stopAutoPlay(); btnLast.click(); }
            if (e.key === " " || e.key === "k") { e.preventDefault(); togglePlay(); }
        });

        buildMoveList();
        renderBoard();
    </script>
    </body>
</html>